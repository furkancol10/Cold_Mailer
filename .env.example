# Bu dosyayı kopyalayıp ".env" olarak kaydet, gerçek değerlerle doldur.
# .env dosyasını asla Git'e commit etme!

# ── Django ────────────────────────────────────────────────────
SECRET_KEY=buraya-cok-gizli-bir-anahtar-yaz
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── PostgreSQL ────────────────────────────────────────────────
DATABASE_URL=postgres://kullanici:sifre@localhost:5432/smartreach_db

# ── Redis (Celery için) ───────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0

# ── Anthropic Claude API ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Google OAuth2 (allauth + Gmail API) ───────────────────────
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ── E-Mail Takibi ─────────────────────────────────────────────
# Tracking pixel için uygulamanın dışarıdan erişilebilir URL'si
APP_BASE_URL=http://localhost:8000
